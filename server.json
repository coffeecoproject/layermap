{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.coffeecoproject/layermap",
  "title": "LayerMap",
  "description": "Call graph for coding agents: callers up to HTTP routes, callees, usages for TS/JS, Go, Python, Java",
  "repository": {
    "url": "https://github.com/coffeecoproject/layermap",
    "source": "github"
  },
  "websiteUrl": "https://github.com/coffeecoproject/layermap#readme",
  "version": "0.1.8",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "layermap",
      "version": "0.1.8",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
